# Copy this file to .env.local for local development (git-ignored).
# For the live site, add the same names/values in Vercel:
#   Project → Settings → Environment Variables
#
# Full step-by-step setup instructions: README.md → "Reviews: admin setup"

# --- Supabase (stores review submissions + photos) ---
# From your Supabase project: Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin login (/admin) ---
# Any password you choose — this is what you'll type in at /admin/login.
ADMIN_PASSWORD=
# A long random string used to sign the admin login session. Generate one
# with: openssl rand -base64 32
SESSION_SECRET=
